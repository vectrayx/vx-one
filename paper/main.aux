\citation{hendrycks2017}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces LOAO on stratified CIC (Small). Softmax confidence saturates: the fixed threshold abstains on nothing, and unseen families get attributed to \texttt  {normal} with high confidence. $^{\dagger }$\,=\,degenerate folds ($n{=}1$ and $n{=}5$ test rows: the AUROC is a coin toss and is quoted for completeness only).}}{6}{table.caption.25}\protected@file@percent }
