\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Abstention sweep over $\tau _{\mathrm  {abs}}\in \{0.05,\ldots  ,0.99\}$, mean over LOAO folds, on excluded-family test rows. \textbf  {UNSW:} an operating frontier exists---abstention and false attack attribution cross near $\tau {=}0.5$, and large $\tau $ recovers honesty (97\% abstain, $<$1\% false attribution). \textbf  {CIC:} no operating point---unseen-family events are absorbed into \texttt  {normal} ($\sim $94\%) at saturated confidence (median max-prob $1.000$; median margin $1.000$), so no post-hoc threshold or margin policy can recover them.}}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:tau}{{1}{7}{Abstention sweep over $\tau _{\mathrm {abs}}\in \{0.05,\ldots ,0.99\}$, mean over LOAO folds, on excluded-family test rows. \textbf {UNSW:} an operating frontier exists---abstention and false attack attribution cross near $\tau {=}0.5$, and large $\tau $ recovers honesty (97\% abstain, $<$1\% false attribution). \textbf {CIC:} no operating point---unseen-family events are absorbed into \texttt {normal} ($\sim $94\%) at saturated confidence (median max-prob $1.000$; median margin $1.000$), so no post-hoc threshold or margin policy can recover them}{figure.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces E5 cascade over five days of CIC-IDS2017. ``PH1 acc'' is Phase 1 (Suricata) accuracy; ``PH2 acc'' is Phase 2 (VX-One) accuracy on that day's test rows; ``comb'' is the estimated combined cascade; P/R = precision/recall of the combined cascade. PH2/comb use the stratified-split (in-distribution) Phase 2; the by-day Phase 2 re-estimation on the wave day is in the text (P 0.971 / R 0.339) and Mon--Thu are not computable under it. \emph  {Stats are estimates} with a documented independence assumption (Section\nonbreakingspace \ref {sec:limits}).}}{7}{table.caption.28}\protected@file@percent }
\newlabel{tab:e5}{{5}{7}{E5 cascade over five days of CIC-IDS2017. ``PH1 acc'' is Phase 1 (Suricata) accuracy; ``PH2 acc'' is Phase 2 (VX-One) accuracy on that day's test rows; ``comb'' is the estimated combined cascade; P/R = precision/recall of the combined cascade. PH2/comb use the stratified-split (in-distribution) Phase 2; the by-day Phase 2 re-estimation on the wave day is in the text (P 0.971 / R 0.339) and Mon--Thu are not computable under it. \emph {Stats are estimates} with a documented independence assumption (Section~\ref {sec:limits})}{table.caption.28}{}}
